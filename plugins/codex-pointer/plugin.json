{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-pointer",
  "version": "0.5.1",
  "description": "In-client launcher, Windows floating target picker and local context reader for Codex",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex Pointer",
        "shortDescription": "拖一下，把窗口与文件夹带进 Codex",
        "brandColor": "#181818",
        "brandColorDark": "#ededed",
        "composerIcon": "./assets/pointer-light.png",
        "composerIconDark": "./assets/pointer-dark.png",
        "logo": "./assets/pointer-light.png",
        "logoDark": "./assets/pointer-dark.png"
      }
    }
  }
}
